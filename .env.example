# Application variables
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_WHITELIST=http://localhost:5173,https://your-frontend-domain.com
TRUST_PROXY=false

# Rate limiting variables
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_WRITE_MAX=30

# MongoDB variables
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mongo-db-name

# Cloudinary variables
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_TRANSFORMATION_NAME=your-cloudinary-transformation-name

# Resend variables
RESEND_API_KEY=your-api-key
RESEND_MAX_RETRIES=3
RESEND_RETRY_DELAY=1000
RESEND_FROM_EMAIL=your@email.com

# Auth variables
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
